{
  "name": "task-management",
  "description": "Actioを正本とするタスク連携。登録・期限・カテゴリ・完了、数値IDの互換参照、棚卸し(task-review/task-triage)と目標評価(goals)を扱う。",
  "role": "semantic",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "(^|/)server/task-review/[^/]+$"
    },
    {
      "pathPattern": "(^|/)server/task-triage/[^/]+$"
    },
    {
      "pathPattern": "(^|/)server/goals/[^/]+$"
    },
    {
      "pathPattern": "(^|/)server/routes/(?:task|task\\.test|task-review|impl|staleness)\\.ts$"
    },
    {
      "pathPattern": "(^|/)server/shared/task-registration\\.ts$"
    },
    {
      "pathPattern": "(^|/)server/shared/task-mutation\\.ts$"
    },
    {
      "pathPattern": "(^|/)server/public/src/task-(?:review|triage)-view\\.ts$"
    },
    {
      "pathPattern": "(^|/)server/queue\\.ts$"
    },
    {
      "pathPattern": "(^|/)server/tasks/[^/]+$"
    }
  ],
  "specRefs": [
