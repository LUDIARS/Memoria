    {
      "pathPattern": "(^|/)server/shared/[^/]+$"
    },
    {
      "pathPattern": "(^|/)server/core/[^/]+$"
    },
    {
      "pathPattern": "(^|/)server/hooks/[^/]+$"
    },
    {
      "pathPattern": "(^|/)server/[^/]+\\.(?:ts|mjs|js)$"
    }
  ],
  "specRefs": [
    "spec/feature/shared-one-shot.md"
