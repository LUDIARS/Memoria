{
  "$comment": "Anatomia のプログラムドメイン (二層判定) 用の層宣言。 glob は repo 相対のファイルパスに前方一致ではなく完全一致で当たる (`*` = 1 階層、 `**` = 任意階層)。 loader が glob 文字列でソートしてから先勝ちで評価するため、 記述順は効かない。 したがって **glob 同士を重ねない** — モジュール 1 つにつき `<dir>/*` を 1 本だけ置き、 入れ子のディレクトリには別途 1 本置く。",

  "layers": [
    { "glob": "*", "layer": "application" },

    { "glob": "server/public/*", "layer": "presentation" },
    { "glob": "server/public/src/*", "layer": "presentation" },
    { "glob": "server/public/src/notes/*", "layer": "presentation" },
    { "glob": "server/public/src/types/*", "layer": "presentation" },
    { "glob": "server/api/types/*", "layer": "presentation" },
    { "glob": "server/routes/*", "layer": "presentation" },
    { "glob": "server/discord/*", "layer": "presentation" },
    { "glob": "server/discord/notify/*", "layer": "presentation" },
    { "glob": "server/discord/actions/*", "layer": "presentation" },
    { "glob": "server/alexa/*", "layer": "presentation" },
    { "glob": "extension/*", "layer": "presentation" },
    { "glob": "desktop/src/*", "layer": "presentation" },
    { "glob": "mcp-server/*", "layer": "presentation" },
    { "glob": "server/plugins/memoria-plugin/plugins/furusato-nozei/routes/*", "layer": "presentation" },
    { "glob": "server/plugins/memoria-plugin/plugins/furusato-nozei/ui/*", "layer": "presentation" },

    { "glob": "server/*", "layer": "application" },
    { "glob": "server/hooks/*", "layer": "application" },
    { "glob": "server/scripts/*", "layer": "application" },
    { "glob": "server/plugins/*", "layer": "application" },
    { "glob": "server/plugins/memoria-plugin/host/*", "layer": "application" },
    { "glob": "server/plugins/memoria-plugin/scripts/*", "layer": "application" },
    { "glob": "desktop/scripts/*", "layer": "application" },

    { "glob": "server/ai-hub/*", "layer": "domain-logic" },
    { "glob": "server/books/*", "layer": "domain-logic" },
    { "glob": "server/books/sources/*", "layer": "domain-logic" },
    { "glob": "server/briefing/*", "layer": "domain-logic" },
    { "glob": "server/briefing/sources/*", "layer": "domain-logic" },
    { "glob": "server/clever-search/*", "layer": "domain-logic" },
    { "glob": "server/goals/*", "layer": "domain-logic" },
    { "glob": "server/llm-usage/*", "layer": "domain-logic" },
    { "glob": "server/multi/*", "layer": "domain-logic" },
    { "glob": "server/parsers/*", "layer": "domain-logic" },
    { "glob": "server/personality-export/*", "layer": "domain-logic" },
    { "glob": "server/release-watch/*", "layer": "domain-logic" },
    { "glob": "server/roadmap/*", "layer": "domain-logic" },
    { "glob": "server/rss/*", "layer": "domain-logic" },
    { "glob": "server/shared/*", "layer": "domain-logic" },
    { "glob": "server/shopping/*", "layer": "domain-logic" },
    { "glob": "server/spending-log/*", "layer": "domain-logic" },
    { "glob": "server/task-review/*", "layer": "domain-logic" },
    { "glob": "server/task-triage/*", "layer": "domain-logic" },
    { "glob": "server/weather/*", "layer": "domain-logic" },
    { "glob": "server/weather/sources/*", "layer": "domain-logic" },
    { "glob": "server/plugins/memoria-plugin/plugins/furusato-nozei/*", "layer": "domain-logic" },
    { "glob": "server/plugins/memoria-plugin/plugins/furusato-nozei/jobs/*", "layer": "domain-logic" },

    { "glob": "server/db/*", "layer": "infrastructure" },
    { "glob": "server/db/types/*", "layer": "infrastructure" },
    { "glob": "server/lib/*", "layer": "infrastructure" },
    { "glob": "server/local/*", "layer": "infrastructure" },
    { "glob": "server/mqtt/*", "layer": "infrastructure" },
    { "glob": "server/owntracks/*", "layer": "infrastructure" },
    { "glob": "server/types/*", "layer": "infrastructure" }
  ],

  "mergeCouplingThreshold": 1
}
